{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "vcpkg manifest mode with the project triplets (same install tree as MSBuild: vcpkg_installed/<triplet>)",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets",
        "VCPKG_MANIFEST_DIR": "${sourceDir}"
      }
    },
    {
      "name": "x64",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-mp",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x64-windows-mp"
      }
    },
    {
      "name": "x86",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-mp",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/x86-windows-mp"
      }
    },
    {
      "name": "unicode",
      "hidden": true,
      "cacheVariables": {
        "MP_CHARSET": "UNICODE"
      }
    },
    {
      "name": "mbcs",
      "hidden": true,
      "cacheVariables": {
        "MP_CHARSET": "MBCS"
      }
    },
    {
      "name": "vs2026",
      "hidden": true,
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "vs2022",
      "hidden": true,
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "vs2026-x64-unicode",
      "displayName": "Visual Studio 2026 x64 UNICODE",
      "inherits": [
        "vs2026",
        "x64",
        "unicode"
      ],
      "binaryDir": "${sourceDir}/build/vs2026-x64-unicode"
    },
    {
      "name": "vs2026-x64-mbcs",
      "displayName": "Visual Studio 2026 x64 MBCS",
      "inherits": [
        "vs2026",
