<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <appSettings>
    <add key="version" value="1.39-Endurance" />
  </appSettings>

  <runtime>
    <!-- legacyUnhandledExceptionPolicy enabled="true" /> -->
	  <appDomainManagerAssembly value="MediaPortal.DomainManager" />
	  <appDomainManagerType value="MediaPortal.DomainManager.CustomDomainManager" />
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
